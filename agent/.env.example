# The model is served by any OpenAI-compatible provider. OPENAI_API_KEY is that
# provider's key; OPENAI_BASE_URL is its endpoint.
#   OpenAI (default): https://api.openai.com/v1,    key from https://platform.openai.com/api-keys
#   OpenRouter:       https://openrouter.ai/api/v1, key from https://openrouter.ai/settings/keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the default model used by src/tech_support_agent/config.py.
# Named as the provider names it: gpt-6.1-sol on OpenAI, openai/gpt-6.1-sol
# on OpenRouter (https://openrouter.ai/models).
AGENT_MODEL=gpt-6.1-sol

# Optional but recommended for tracing.
# Read from the process environment by the LangSmith SDK, not via Settings.
# Set LANGSMITH_TRACING=false when you have no LangSmith key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...

# Target project for traces. Defaults to "default" when unset.
LANGSMITH_PROJECT=tech-support-agent-dev

# Bug intake demo only. Both processes need the same operator-generated token
# (at least 32 ASCII characters, no whitespace). Never use NEXT_PUBLIC_* for it.
# Leave blank until configured; there is no insecure default token.
BUG_WORKER_TOKEN=
BUG_WORKER_URL=http://127.0.0.1:2025
BUG_SCENARIO=continue
BUG_REQUEST_TIMEOUT=2
BUG_POLL_TIMEOUT=5
BUG_POLL_INTERVAL=0.1
# Phase 3 worker uses separate settings below; the general support model is unchanged.

# Phase 2: operator-selected demo coordinates and an absolute directory OUTSIDE
# this support repository. There are deliberately no defaults for these values.
# Used by the staging/preview commands only; no model/Telegram/GitHub key needed.
BUG_DEMO_REPO=
BUG_DEMO_REPO_DIR=
BUG_SANDBOX_IMAGE=bug-resolution-sandbox:phase2

# Phase 3: deliberately no guessed model identifier, credentials or private target.
# OpenAI uses Responses; OpenRouter uses Chat Completions. No provider fallback.
# Set BUG_MODEL to the exact provider model ID; preflight verifies tools/schema.
# To reuse the OpenAI settings above in this dotenv file, use:
# BUG_MODEL=${AGENT_MODEL} and BUG_MODEL_API_KEY=${OPENAI_API_KEY}
BUG_MODEL=
BUG_MODEL_API_KEY=
BUG_MODEL_BASE_URL=https://api.openai.com/v1
BUG_TELEGRAM_BOT_TOKEN=
BUG_TELEGRAM_USER_ID=
BUG_TELEGRAM_CHAT_ID=
# Existing absolute regular directory, outside symlinked paths, for actual PNG evidence.
BUG_ARTIFACTS_DIR=
BUG_MODEL_TURNS=20
BUG_STAGE_TOOL_CALLS=30
BUG_STAGE_SECONDS=300
BUG_REVIEWER_TOOL_CALLS=15
BUG_REVIEWER_SECONDS=180

# Publication is disabled unless the operator explicitly authorizes remote writes.
# Token stays on the host. Use only the selected non-production demo repository.
BUG_PUBLICATION_AUTHORIZED=false
BUG_GITHUB_TOKEN=
# Exact numeric ID of the trusted .github/workflows/verify.yml workflow.
BUG_GITHUB_WORKFLOW_ID=
BUG_CI_POLL_SECONDS=10
