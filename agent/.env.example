# The model is served by any OpenAI-compatible provider. OPENAI_API_KEY is that
# provider's key; OPENAI_BASE_URL is its endpoint.
#   OpenAI (default): https://api.openai.com/v1,    key from https://platform.openai.com/api-keys
#   OpenRouter:       https://openrouter.ai/api/v1, key from https://openrouter.ai/settings/keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the default model used by src/tech_support_agent/config.py.
# Named as the provider names it: gpt-6.1-sol on OpenAI, openai/gpt-6.1-sol
# on OpenRouter (https://openrouter.ai/models).
AGENT_MODEL=gpt-6.1-sol

# Clerk frontend API URL of the instance the frontend signs in with (Clerk
# dashboard -> API keys -> "Frontend API URL"). Agent Server verifies every
# request's session token against {CLERK_ISSUER}/.well-known/jwks.json.
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Comma-separated origins accepted in the token's azp claim. Empty skips the check.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# The lessons API (api/) the agent's tools call as the signed-in user.
LESSONS_API_URL=http://127.0.0.1:8001

# Optional but recommended for tracing.
# Read from the process environment by the LangSmith SDK, not via Settings.
# Set LANGSMITH_TRACING=false when you have no LangSmith key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...

# Target project for traces. Defaults to "default" when unset.
LANGSMITH_PROJECT=tech-support-agent-dev
