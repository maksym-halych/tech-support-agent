# The model is served by any OpenAI-compatible provider. OPENAI_API_KEY is that
# provider's key; OPENAI_BASE_URL is its endpoint.
#   OpenAI (default): https://api.openai.com/v1,    key from https://platform.openai.com/api-keys
#   OpenRouter:       https://openrouter.ai/api/v1, key from https://openrouter.ai/settings/keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the default model used by src/tech_support_agent/config.py.
# Named as the provider names it: gpt-6.1-sol on OpenAI, openai/gpt-6.1-sol
# on OpenRouter (https://openrouter.ai/models).
AGENT_MODEL=gpt-6.1-sol

# Optional but recommended for tracing.
# Read from the process environment by the LangSmith SDK, not via Settings.
# Set LANGSMITH_TRACING=false when you have no LangSmith key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...

# Target project for traces. Defaults to "default" when unset.
LANGSMITH_PROJECT=tech-support-agent-dev

# One trusted business API. Relative paths are resolved from agent/ when using
# the commands in the README. Never accept these settings from a chat message.
SUPPORT_OPENAPI_PATH=examples/lessons.openapi.json
SUPPORT_API_BASE_URL=http://127.0.0.1:8001
SUPPORT_IDEMPOTENCY_HEADER=Idempotency-Key

# Local demo identity; the future orchestrator supplies verified context.
# demo-alice and demo-bob are deliberately public tokens for the local demo only.
SUPPORT_USER_ID=alice
SUPPORT_API_TOKEN=demo-alice
# For header API-key auth, keys are security scheme names from OpenAPI:
# SUPPORT_API_KEYS={"KeyAuth":"your-api-key"}
SUPPORT_TIMEZONE=Europe/Kyiv
SUPPORT_CHECKPOINT_PATH=data/support.sqlite
SUPPORT_JOURNAL_PATH=data/actions.sqlite
