{
  "openapi": "3.1.0",
  "info": {
    "title": "Lesson booking demo",
    "description": "Find teachers, look up free slots by an exact local date, then book a selected slot for the authenticated user. All times use Europe/Kyiv. Reuse Idempotency-Key only for an identical booking request.",
    "version": "1.0.0"
  },
  "paths": {
    "/teachers": {
      "get": {
        "summary": "List English lesson teachers",
        "description": "Return the teachers available in the demo.",
        "operationId": "list_teachers",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Teacher"
                  },
                  "type": "array",
                  "title": "Response List Teachers"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/slots": {
      "get": {
        "summary": "Find available slots on an exact date",
        "description": "Return future unbooked slots; compare starts_at to the requested time.",
        "operationId": "list_available_slots",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Exact calendar date in Europe/Kyiv, YYYY-MM-DD",
              "title": "Date"
            },
            "description": "Exact calendar date in Europe/Kyiv, YYYY-MM-DD"
          },
          {
            "name": "teacher_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Teacher Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Slot"
                  },
                  "title": "Response List Available Slots"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me/bookings": {
      "post": {
        "summary": "Book a selected slot for the current user",
        "description": "Create one booking; replaying the same key returns the original booking.",
        "operationId": "create_booking",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBooking"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "409": {
            "description": "Slot is already booked or the idempotency key was used for another slot"
          },
          "404": {
            "description": "The slot does not exist or is in the past"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List the current user's bookings",
        "description": "Return only bookings belonging to the authenticated user.",
        "operationId": "list_my_bookings",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  },
                  "title": "Response List My Bookings"
                }
              }
            }
          }
        }
      }
    },
    "/me/bookings/{booking_id}": {
      "get": {
        "summary": "Get a confirmed booking by ID",
        "description": "Look up one booking without revealing other users' records.",
        "operationId": "get_my_booking",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "booking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Booking Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "404": {
            "description": "Booking not found for the current user"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Booking": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slot": {
            "$ref": "#/components/schemas/Slot"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "slot"
        ],
        "title": "Booking",
        "description": "A confirmed booking belonging to the current user."
      },
      "CreateBooking": {
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1,
            "title": "Slot Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "slot_id"
        ],
        "title": "CreateBooking",
        "description": "Selected slot; identity comes only from the authenticated token."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Slot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "teacher_id": {
            "type": "string",
            "title": "Teacher Id"
          },
          "teacher_name": {
            "type": "string",
            "title": "Teacher Name"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ends At"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Kyiv"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "teacher_id",
          "teacher_name",
          "starts_at",
          "ends_at"
        ],
        "title": "Slot",
        "description": "A lesson with an explicit date, time and timezone."
      },
      "Teacher": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "subject"
        ],
        "title": "Teacher",
        "description": "A demo teacher."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
