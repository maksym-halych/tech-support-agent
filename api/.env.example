# Clerk frontend API URL of the instance the frontend signs in with. It is the
# session token issuer; signing keys are fetched from {issuer}/.well-known/jwks.json.
# Find it in the Clerk dashboard under API keys ("Frontend API URL").
LESSONS_API_CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Comma-separated origins accepted in the token's azp claim. Empty skips the check.
LESSONS_API_CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Comma-separated browser origins allowed by CORS.
LESSONS_API_CORS_ORIGINS=http://localhost:3000

# Bind address and port for `uv run lessons-api`.
LESSONS_API_HOST=127.0.0.1
LESSONS_API_PORT=8001

# SQLite file, relative to api/.
LESSONS_API_DATABASE_PATH=data/lessons.sqlite
